# Tramevia Dock — configuration (copy to .env). Everything is optional for a local install.
# Tramevia Dock — configuration (copie ce fichier en .env). Tout est facultatif en local.

# Port and public address. Redirect URIs registered on each platform are built from PUBLIC_URL.
# Port et adresse publique. Les URL de redirection déclarées sur chaque plateforme dérivent de PUBLIC_URL.
PORT=8787
# PUBLIC_URL=http://localhost:8787

# Required as soon as the app is reachable from the network (cloud, LAN, tunnel). 12+ characters.
# Obligatoire dès que l'app est accessible depuis le réseau (cloud, LAN, tunnel). 12 caractères minimum.
# ADMIN_PASSWORD=

# Key used to encrypt stored tokens. Auto-generated in DATA_DIR/secret.key if empty (keep backups!).
# Clé de chiffrement des jetons. Générée automatiquement dans DATA_DIR/secret.key si vide.
# TOKEN_KEY=

# Where the database lives. / Emplacement de la base de données.
# DATA_DIR=./data

# Platform apps (optional: you can also enter them in the setup wizard).
# Applications des plateformes (facultatif : tu peux aussi les saisir dans l'assistant).
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# KICK_CLIENT_ID=
# KICK_CLIENT_SECRET=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=

# TikTok (unofficial): optional Euler Stream API key for the signing server.
# TikTok (non officiel) : clé API Euler Stream facultative pour le serveur de signature.
# TIKTOK_SIGN_API_KEY=

# Advanced / Avancé
# HOST=127.0.0.1            # 0.0.0.0 to listen on the network (requires ADMIN_PASSWORD)
# ALLOWED_HOSTS=            # extra Host headers to accept, comma separated (e.g. mypc.local:8787)
# OPEN_BROWSER=0            # do not open the browser at startup
